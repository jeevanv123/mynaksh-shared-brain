# ---- LLM -------------------------------------------------------------
# openai  = any OpenAI-compatible endpoint (OpenAI, Bifrost/Azure gateway, Gemini OpenAI endpoint, Ollama)
# anthropic = native Anthropic API
# fake    = deterministic offline provider (no key needed)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
# Leave empty for api.openai.com. For a gateway: https://your-gateway.example.com
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
# Optional cheaper model for extraction/classification side calls
LLM_SMALL_MODEL=
# Optional second model to try if the primary keeps failing
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- Graph store -----------------------------------------------------
# neo4j | memory
GRAPH_STORE=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# If Neo4j is down at startup, keep serving with the in-memory store
GRAPH_FALLBACK_TO_MEMORY=true

# ---- Memory / context tuning ----------------------------------------
SHORT_TERM_MAX_TURNS=20
RECENT_TURNS_IN_PROMPT=6
RECENT_TURNS_IN_PROMPT_FOLLOWUP=10
MAX_MEMORIES_IN_PROMPT=8
CONTEXT_CHAR_BUDGET=6000
MEMORY_CONFIDENCE_FLOOR=0.55
USE_LLM_FOR_INTENT=true
LOG_LEVEL=INFO
